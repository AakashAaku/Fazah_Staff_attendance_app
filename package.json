{
  "name": "garage-clock",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:kiosk": "npm run dev -w apps/kiosk",
    "build": "npm run build -w apps/api && npm run build -w apps/kiosk",
    "build:all": "npm run build --workspaces --if-present",
    "seed": "node seed.js",
    "start": "npm run start:prod -w apps/api"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  }
}
